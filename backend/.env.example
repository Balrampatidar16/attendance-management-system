# === Server ===
NODE_ENV=development
PORT=5000

# === Database ===
# MongoDB Atlas connection string. Whitelist 0.0.0.0/0 in Atlas network access if deploying to Render.
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/attendance_db

# === JWT ===
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# === Google OAuth ===
# From Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Client ID, Web application).
# Only the Client ID is needed — the ID-token flow used here never requires the client secret.
GOOGLE_CLIENT_ID=

# === Cloudinary (selfie storage) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === CORS ===
# Deployed frontend URL in production (e.g. https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173

# === Business rules ===
STANDARD_SHIFT_HOURS=8

# === Geofencing (bonus) ===
GEOFENCE_ENABLED=false
OFFICE_LATITUDE=22.7196
OFFICE_LONGITUDE=75.8577
GEOFENCE_RADIUS_METERS=200

# === Logging ===
LOG_LEVEL=info
